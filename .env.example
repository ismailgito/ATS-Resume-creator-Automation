# ==============================================================================
# ATS RESUME AUTOMATION - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in your credentials when ready:
#   copy .env.example .env
#
# NOTE: The system works out-of-the-box in OFFLINE/HEURISTIC mode even without
# any API keys. Once you provide API keys below, it automatically upgrades to
# live LLM-powered parsing, tailoring, and validation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER & CREDENTIALS
# ------------------------------------------------------------------------------
# Provider options: "gemini", "openai", "anthropic", "offline" (auto-detected if blank)
LLM_PROVIDER=offline

# Google Gemini (Recommended for Antigravity)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional custom base URL (e.g. for local Ollama, vLLM, or enterprise proxy)
LLM_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. NAUKRI / JOB PLATFORM INTEGRATION
# ------------------------------------------------------------------------------
# Official API token / OAuth client (if approved for your account)
NAUKRI_API_TOKEN=your_naukri_api_token_here
NAUKRI_CLIENT_ID=your_naukri_client_id_here
NAUKRI_CLIENT_SECRET=your_naukri_client_secret_here

# For human-assisted browser helper (Never automated submission)
NAUKRI_SAVED_SEARCH_URL=https://www.naukri.com/performance-marketing-jobs

# ------------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY DATA / SCRAPING (Apify)
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase REST API credentials (from Supabase Dashboard Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Direct Supabase PostgreSQL URI (Optional alternative connection mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=


# ------------------------------------------------------------------------------
# 5. NOTIFICATION INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Slack / Discord Webhook URL
NOTIFY_WEBHOOK_URL=

# Daily resume creation limit (pipeline stops notifying after this count each UTC day)
DAILY_LIMIT=10

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL_TO=your_destination_email@gmail.com

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION PATHS
# ------------------------------------------------------------------------------
CANDIDATE_PROFILE_PATH=data/candidate-profile.json
SCORING_CONFIG_PATH=config/scoring.yaml
POLICY_CONFIG_PATH=config/policy.yaml
MIN_MATCH_SCORE=75
OUTPUT_DIR=outputs
